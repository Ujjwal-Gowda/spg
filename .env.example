# Free public services (no API key required)

# Tiles — Standard OpenStreetMap tiles
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Routing — OSRM public demo server
VITE_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# Geocoding — Photon (Komoot) public server
VITE_GEOCODER_URL=https://photon.komoot.io

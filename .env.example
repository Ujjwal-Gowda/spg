# Copy to .env and fill in before building for anyone but yourself.
# The public demo servers are unlicensed for distributed apps (see README).

# Tiles — MapTiler / Stadia / Protomaps all have free tiers
VITE_TILE_URL=https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Routing — OpenRouteService free tier, or your own OSRM
VITE_ROUTING_URL=https://your-osrm-host/route/v1/driving

# Geocoding — Photon's terms are the most relaxed, or self-host
VITE_GEOCODER_URL=https://photon.komoot.io
